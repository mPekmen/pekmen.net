---
import "@fontsource-variable/inter-tight";
import LanguageMenu from "../components/admin/StudioLanguage.astro";
import "../styles/global.css";
import "../styles/admin.css";

import { studioSections, studioPath, studioT, type StudioSection } from "../server/studio";
import type { Lang } from "../i18n/languages";

interface Props {
  title: string;
  lang: Lang;
  section?: StudioSection;
  logoutToken?: string;
}

const { title, section, logoutToken, lang } = Astro.props;
const t = studioT(lang);
const sections = Object.entries(studioSections);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f5f2eb" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="studio-body">
    {section ? (
      <div class="studio-shell">
        <a class="studio-skip" href="#studio-main">{t("İçeriğe geç")}</a>
        <aside class="studio-sidebar">
          <a href="/admin" class="studio-brand">
            <span class="studio-mark" aria-hidden="true">P.</span>
            <span>Pekmen Studio<small>{t("Yönetim paneli")}</small></span>
          </a>
          <nav class="studio-nav" aria-label={t("Yönetim bölümleri")}>
            {sections.map(([id, label]) => (
              <a href={studioPath(id as StudioSection)} aria-current={section === id ? "page" : undefined}>
                <span>{label[lang]}</span>
              </a>
            ))}
          </nav>
          <div class="studio-account">
            <a href="/" class="studio-site">{t("Siteye dön")} <span aria-hidden="true">↗</span></a>
            <form method="post" action="/api/admin/logout">
              <input type="hidden" name="csrf" value={logoutToken} />
              <button type="submit">{t("Çıkış yap")}</button>
            </form>
          </div>
        </aside>
        <main class="studio-main" id="studio-main" tabindex="-1"><LanguageMenu {lang} /><slot /></main>
      </div>
    ) : (
      <main class="studio-login" id="studio-main">
        <header><a class="studio-brand" href="/"><span class="studio-mark" aria-hidden="true">P.</span> Pekmen Studio</a><a href="/">{t("Siteye dön")}</a></header>
        <LanguageMenu {lang} />
        <slot />
      </main>
    )}
  </body>
</html>
