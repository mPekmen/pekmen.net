---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminAppointment from "./AdminAppointment.astro";
import { ADMIN_COOKIE, ADMIN_LOGIN_COOKIE, adminCsrfToken, createSessionToken, isAdminConfigured, sessionCookieOptions, verifySessionToken } from "../../server/admin";
import { readAdminBookings } from "../../server/admin-bookings";
import { bookingConfig, isEmailConfigured } from "../../server/config";
import { dateKeyInZone } from "../../server/time";
import type { BookingEvent } from "../../server/google";

import StudioModules from "./StudioModules.astro";
import { projects } from "../../data/projects";
import { inboxSummary } from "../../server/studio-messages";
import { studioSections, studioPath, studioLocale, studioT, type StudioSection } from "../../server/studio";

const lang = studioLocale(Astro);
const t = studioT(lang);
interface Props { section: StudioSection }
const { section } = Astro.props;
const session = Astro.cookies.get(ADMIN_COOKIE)?.value ?? "";
const authed = verifySessionToken(session);
const configured = isAdminConfigured();
let loginSession = Astro.cookies.get(ADMIN_LOGIN_COOKIE)?.value ?? "";
if (configured && !authed && !verifySessionToken(loginSession, "login")) {
  loginSession = createSessionToken("login");
  Astro.cookies.set(ADMIN_LOGIN_COOKIE, loginSession, sessionCookieOptions(Astro.url, "login"));
}
const params = Astro.url.searchParams;
const errorKey = params.get("error") ?? "";
const okKey = params.get("ok") ?? "";
const mailResult = params.get("mail");
const settings = bookingConfig();
const { timeZone } = settings;
const calendarPage = section === "overview" || section === "appointments" || section === "settings";
const snapshot = authed && calendarPage ? await readAdminBookings(params.get("refresh") === "1" || Boolean(okKey)) : null;
const ready = snapshot?.state === "ready" ? snapshot : null;
const bookings = ready?.bookings ?? [];
const pending = bookings.filter((booking) => booking.bookingStatus === "pending");
const confirmed = bookings.filter((booking) => booking.bookingStatus === "confirmed");
const next = confirmed[0];
const day = new Intl.DateTimeFormat(lang, { dateStyle: "full", timeZone });
const dateTime = new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "short", timeZone });
const groups = new Map<string, BookingEvent[]>();
for (const booking of bookings) {
  const key = dateKeyInZone(new Date(booking.start), timeZone);
  const group = groups.get(key);
  if (group) group.push(booking);
  else groups.set(key, [booking]);
}
const page = { title: studioSections[section][lang], path: studioPath(section) };
const inbox = authed && section === "overview" ? await inboxSummary(Astro.locals.studioMessages) : null;
const calendarStatus = ready ? t("Takvim erişilebilir") : snapshot?.state === "unconfigured" ? t("Yapılandırılmamış") : t("Takvim okunamadı");
const calendarMessage = snapshot?.state === "unconfigured"
  ? t("Google Takvim bağlantısı yapılandırılmamış.")
  : t("Google Takvim okunamadı. Bağlantıyı yenileyerek tekrar deneyin.");
const coordinatorConfigured = Boolean(Astro.locals.bookingCoordinator);
const emailConfigured = isEmailConfigured();
const weekday = new Intl.DateTimeFormat(lang, { weekday: "short", timeZone: "UTC" });
const workDayNames = Array.from({ length: 7 }, (_, index) => weekday.format(Date.UTC(2024, 0, 7 + index)));
const workTime = (hour: number) => String(hour).padStart(2, "0") + ":00";
const errors = new Map(Object.entries({
  config: t("Panelin güvenlik yapılandırması tamamlanmamış."),
  password: t("Şifre yanlış. Tekrar deneyin."),
  rate: t("Çok fazla deneme yapıldı. Birkaç dakika sonra tekrar deneyin."),
  auth: t("Oturum sona erdi. Yeniden giriş yapın."),
  csrf: t("Giriş formunun süresi doldu. Yeniden deneyin."),
  cancel_confirmation: t("İptali randevu ayrıntılarından açıkça onaylayın."),
  id: t("Geçersiz kayıt."),
  not_found: t("Randevu bulunamadı. İptal edilmiş olabilir."),
  booking_in_progress: t("Takvim işleminin sonucu henüz doğrulanmadı. Biraz sonra tekrar kontrol edin."),
  slot: t("Seçilen saat artık müsait değil. Başka bir saat seçin."),
  invalid_slot: t("Geçerli bir saat seçin."),
  missing_email: t("Katılımcının e-posta adresi bulunamadı."),
  google_auth: t("Google Takvim bağlantısı doğrulanamadı."),
  google_error: t("Google Takvim isteği reddedildi."),
  not_configured: t("Randevu koordinatörü yapılandırılmamış."),
  confirm: t("Randevu onaylanamadı."),
  update: t("Randevu güncellenemedi."),
  delete: t("Randevu iptal edilemedi."),
}));
const successes = new Map(Object.entries({
  confirmed: t("Randevu takvimde onaylandı."),
  rescheduled: t("Randevunun yeni saati takvimde kayıtlı."),
  canceled: t("Randevu takvimde iptal edildi."),
  already: t("Bu randevu zaten takvimde onaylı."),
}));
const errorText = errors.get(errorKey);
const okText = successes.get(okKey);
const mailText = mailResult === "0" ? t("E-posta gönderilemedi. Katılımcıya elle haber vermeniz gerekebilir.")
  : mailResult === "1" ? t("Bildirim e-posta sağlayıcısına iletildi.")
  : mailResult === "skipped" || okKey === "already" ? t("Yeni bir bildirim e-postası gönderilmedi.") : "";
---

<AdminLayout title={authed ? `${page.title} — Pekmen Studio` : t("Giriş — Pekmen Studio")}
  {lang} section={authed ? section : undefined}
  logoutToken={authed ? adminCsrfToken(session, "logout") : undefined}>
  {!authed ? (
    <section class="studio-login-card">
      <p class="studio-kicker">{t("Özel alan")}</p>
      <h1>{configured ? t("Panele giriş") : t("Kurulum gerekli")}</h1>
      <p class="studio-muted">{configured ? t("Randevularınızı yönetmek için giriş yapın.") : t("Yönetici oturumu için sunucu yapılandırmasını kontrol edin.")}</p>
      {configured && (
        <form method="post" action="/api/admin/login" class="studio-editor-form">
          <input type="hidden" name="csrf" value={adminCsrfToken(loginSession, "login")} />
          <label>{t("Şifre")}<input name="password" type="password" autocomplete="current-password" required /></label>
          <button class="studio-button studio-button--primary" type="submit">{t("Giriş yap")}</button>
        </form>
      )}
      {errorText && <p class="studio-notice studio-notice--error" role="alert">{errorText}</p>}
    </section>
  ) : (
    <div class="studio-workspace" data-admin-live data-signature={ready?.signature} data-time-zone={timeZone}>
      <header class="studio-page-header">
        <div>
          <p class="studio-kicker">Pekmen Studio</p>
          <h1>{page.title}</h1>
        </div>
        {calendarPage && <a class="studio-button" href={page.path + "?refresh=1"} data-refresh-link>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10a8 8 0 1 0-1 7M20 4v6h-6" /></svg>
          {t("Yenile")}
        </a>}
      </header>
      {calendarPage && <div class="studio-sync">
        <span class:list={["studio-status", ready ? "studio-status--good" : "studio-status--attention"]} data-calendar-status>{calendarStatus}</span>
        <p role="status" data-refresh-status>{ready ? `${t("Son başarılı güncelleme")} ${dateTime.format(ready.checkedAt)}` : t("Son başarılı kontrol bilgisi yok.")}</p>
      </div>}

      {okText && <div class="studio-notice studio-notice--good" role="status" tabindex="-1" data-operation-feedback>
        <strong>{okText}</strong>
        {mailText && <p class:list={{ "studio-mail-error": mailResult === "0" }}>{mailText}</p>}
      </div>}
      {errorText && <p class="studio-notice studio-notice--error" role="alert" tabindex="-1" data-operation-feedback>{errorText}</p>}

      {calendarPage && section !== "settings" && !ready && <p class="studio-notice studio-notice--error" role="status">{calendarMessage}</p>}

      {section === "overview" && <div class="studio-metrics">
        <section class="studio-card studio-metric"><h2>{t("Yayındaki projeler")}</h2><strong>{projects.filter((item) => !item.archived).length}</strong><a href="/admin/projects">{studioSections.projects[lang]}</a></section>
        <section class="studio-card studio-metric"><h2>{t("Sistem durumu")}</h2><strong class="studio-next">{calendarStatus}</strong><a href="/admin/settings">{studioSections.settings[lang]}</a></section>
        {inbox !== null && <section class="studio-card studio-metric"><h2>{t("Okunmamış mesajlar")}</h2><strong>{inbox}</strong><a href="/admin/messages">{studioSections.messages[lang]}</a></section>}
      </div>}
      {section === "overview" && ready && (
        <>
          <div class="studio-metrics">
            <section class="studio-card studio-metric studio-metric--attention">
              <h2>{t("Onay bekleyen")}</h2><strong>{pending.length}</strong>
              <a href="/admin/appointments#pending">{t("Bekleyenleri aç")} <span aria-hidden="true">↗</span></a>
            </section>
            <section class="studio-card studio-metric">
              <h2>{t("Onaylı randevular")}</h2><strong>{confirmed.length}</strong>
              <a href="/admin/appointments">{t("Randevuları aç")} <span aria-hidden="true">↗</span></a>
            </section>
            <section class="studio-card studio-metric">
              <h2>{t("Sıradaki görüşme")}</h2><strong class="studio-next">{next?.name ?? t("Onaylı görüşme yok")}</strong>
              {next && <time datetime={next.startIso}>{dateTime.format(next.start)}</time>}
            </section>
          </div>
          <section class="studio-card studio-queue">
            <header class="studio-section-head"><div><h2>{t("Onay kuyruğu")}</h2><p class="studio-muted">{t("Onaylandığında katılımcıya bildirim gönderilmeye çalışılır.")}</p></div></header>
            {pending.length ? (
              <ul class="studio-appointments">
                {pending.slice(0, 4).map((booking) => <AdminAppointment {booking} {session} {timeZone} {lang} leadHours={settings.leadHours} compact />)}
              </ul>
            ) : <p class="studio-empty">{t("Onay bekleyen talep yok.")}</p>}
            {pending.length > 4 && <a class="studio-queue-footer" href="/admin/appointments#pending">{t("Tüm bekleyen talepler")}</a>}
          </section>
          <section class="studio-card studio-queue">
            <header class="studio-section-head"><div><h2>{t("Yaklaşan görüşmeler")}</h2><p class="studio-muted">{t("Onaylanmış randevular, tarih sırasıyla.")}</p></div></header>
            {confirmed.length ? (
              <ul class="studio-appointments">
                {confirmed.slice(0, 4).map((booking) =>
                  <AdminAppointment {booking} {session} {timeZone} {lang} leadHours={settings.leadHours} compact />)}
              </ul>
            ) : <p class="studio-empty">{t("Yaklaşan onaylı görüşme yok.")}</p>}
          </section>
        </>
      )}

      {section === "appointments" && ready && (
        <section class="studio-card studio-directory">
          <header class="studio-section-head"><div><h2>{t("Randevu listesi")}</h2><p class="studio-muted">{t("Yaklaşan kayıtlar")} · {timeZone}</p></div></header>
          <div class="studio-filters" data-appointment-filters hidden>
            <label>{t("Arama")}<input type="search" data-search placeholder={t("İsim veya e-posta")} /></label>
            <label>{t("Durum")}<select data-status><option value="">{t("Tümü")}</option><option value="pending">{t("Onay bekliyor")}</option><option value="confirmed">{t("Onaylandı")}</option></select></label>
            <label>{t("Başlangıç")}<input type="date" data-from /></label>
            <label>{t("Bitiş")}<input type="date" data-to /></label>
            <button type="button" class="studio-button" data-clear>{t("Temizle")}</button>
          </div>
          <p class="studio-results" role="status" data-results>{bookings.length} {t("randevu")}</p>
          <p class="studio-empty" data-filter-empty hidden>{t("Bu filtrelerle eşleşen randevu yok.")}</p>
          {!bookings.length && <p class="studio-empty">{t("Yaklaşan randevu yok.")}</p>}
          {[...groups.values()].map((items) => (
            <section class="studio-day" data-appointment-group>
              <h3>{day.format(items[0]!.start)}</h3>
              <ul class="studio-appointments">
                {items.map((booking) => <AdminAppointment {booking} {session} {timeZone} {lang} leadHours={settings.leadHours} />)}
              </ul>
            </section>
          ))}
        </section>
      )}

      <StudioModules {section} {session} {lang} />
      {section === "settings" && (
        <div class="studio-system-grid">
          <section class="studio-card">
            <header class="studio-section-head"><div><h2>{t("Bağlantılar")}</h2><p class="studio-muted">{t("Bu panelin doğrulayabildiği sistem bilgileri.")}</p></div></header>
            <dl class="studio-properties">
              <div><dt>{t("Google Takvim")}</dt><dd data-system-calendar>{calendarStatus}</dd></div>
              <div><dt>{t("Son başarılı takvim okuması")}</dt><dd data-system-checked>{ready ? dateTime.format(ready.checkedAt) : t("Bilgi yok")}</dd></div>
              <div><dt>{t("Panel sunucusu")}</dt><dd>{t("Bu isteğe yanıt verdi")}</dd></div>
              <div><dt>{t("Randevu koordinatörü")}</dt><dd>{coordinatorConfigured ? t("Yapılandırma mevcut") : t("Yapılandırılmamış")}</dd></div>
              <div><dt>{t("E-posta sağlayıcısı")}</dt><dd>{emailConfigured ? t("Yapılandırılmış · teslimat ölçülmedi") : t("Yapılandırılmamış")}</dd></div>
            </dl>
          </section>
          <section class="studio-card">
            <header class="studio-section-head"><div><h2>{t("Rezervasyon kuralları")}</h2><p class="studio-muted">{t("Sitede uygulanan çalışma saatleri ve sınırlar.")}</p></div></header>
            <dl class="studio-properties">
              <div><dt>{t("Saat dilimi")}</dt><dd>{timeZone}</dd></div>
              <div><dt>{t("Çalışma günleri")}</dt><dd>{settings.workDays.map((item) => workDayNames[item]).join(", ")}</dd></div>
              <div><dt>{t("Çalışma saatleri")}</dt><dd>{workTime(settings.workStartHour)}–{workTime(settings.workEndHour)}</dd></div>
              <div><dt>{t("Görüşme / tampon")}</dt><dd>{settings.durationMinutes} {t("dakika")} / {settings.bufferMinutes} {t("dakika")}</dd></div>
              <div><dt>{t("Talep süresi / ileri tarih sınırı")}</dt><dd>{settings.leadHours} {t("saat")} / {settings.horizonDays} {t("gün")}</dd></div>
            </dl>
          </section>
          {(!ready || !coordinatorConfigured || !emailConfigured) && <section class="studio-card studio-system-alerts">
            <header class="studio-section-head"><h2>{t("Yönetici uyarıları")}</h2></header>
            <ul class="studio-warnings">
              {!ready && <li>{calendarMessage}</li>}
              {!coordinatorConfigured && <li>{t("Randevu yazma işlemleri için koordinatör yapılandırması gerekli.")}</li>}
              {!emailConfigured && <li>{t("Bildirim e-postası göndermek için sağlayıcı yapılandırması gerekli.")}</li>}
            </ul>
          </section>}
        </div>
      )}
    </div>
  )}
</AdminLayout>

<script>
  import { studioT } from "../../i18n/studio-copy";
  import { isLang } from "../../i18n/languages";
  const lang = isLang(document.documentElement.lang) ? document.documentElement.lang : "tr";
  const t = studioT(lang);
  const forms =
    document.querySelectorAll<HTMLFormElement>("[data-reschedule]");

  forms.forEach((form) => {
    const date = form.querySelector<HTMLInputElement>("[data-date]");
    const slots = form.querySelector<HTMLSelectElement>("[data-slots]");
    const hint = form.querySelector<HTMLElement>("[data-hint]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const details = form.closest("details");

    if (!date || !slots || !submit || !hint) return;

    let token = 0;

    const load = async (): Promise<void> => {
      const current = ++token;

      submit.disabled = true;
      slots.disabled = true;
      slots.replaceChildren(new Option(t("Yükleniyor…"), ""));
      hint.textContent = t("Müsait saatler kontrol ediliyor…");

      try {
        const url = new URL("/api/booking", window.location.origin);
        url.searchParams.set("action", "availability");
        url.searchParams.set("date", date.value);

        const response = await fetch(url.toString(), {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });

        const data: unknown = await response.json().catch(() => null);

        if (current !== token) return;

        const list =
          data && typeof data === "object"
            ? (data as { slots?: unknown }).slots
            : null;

        if (!Array.isArray(list)) throw new Error("Invalid response");

        const options = list.filter(
          (slot): slot is { start: string; label: string } =>
            typeof slot === "object" &&
            slot !== null &&
            typeof (slot as { start?: unknown }).start === "string" &&
            typeof (slot as { label?: unknown }).label === "string"
        );

        if (options.length === 0) {
          slots.replaceChildren(new Option(t("Boş saat yok"), ""));
          hint.textContent =
            t("Bu gün için boş saat yok. Başka bir tarih seçin.");
          return;
        }

        slots.replaceChildren(new Option(t("Saat seçin"), ""));
        options.forEach((slot) => {
          slots.append(new Option(slot.label, slot.start));
        });
        slots.disabled = false;
        hint.textContent =
          `${options.length} ${t("boş saat")}`;
      } catch {
        if (current !== token) return;
        slots.replaceChildren(new Option(t("Yüklenemedi"), ""));
        hint.textContent =
          t("Müsaitlik yüklenemedi. Sayfayı yenileyip tekrar deneyin.");
      }
    };

    date.addEventListener("change", () => {
      void load();
    });

    slots.addEventListener("change", () => {
      submit.disabled = !slots.value;
    });

    details?.addEventListener("toggle", () => {
      if (details.open) void load();
    });
  });
</script>

<script>
  import { studioT } from "../../i18n/studio-copy";
  import { isLang } from "../../i18n/languages";
  const lang = isLang(document.documentElement.lang) ? document.documentElement.lang : "tr";
  const t = studioT(lang);
  import { createAdminRefresh } from "../../admin-refresh";
  import { matchesAppointment } from "../../admin-filters";

  const filters = document.querySelector<HTMLElement>("[data-appointment-filters]");
  const search = filters?.querySelector<HTMLInputElement>("[data-search]");
  const bookingStatus = filters?.querySelector<HTMLSelectElement>("[data-status]");
  const from = filters?.querySelector<HTMLInputElement>("[data-from]");
  const to = filters?.querySelector<HTMLInputElement>("[data-to]");
  const groups = [...document.querySelectorAll<HTMLElement>("[data-appointment-group]")].map((group) => ({
    group,
    rows: [...group.querySelectorAll<HTMLElement>("[data-appointment]")].map((row) => ({
      row,
      status: row.dataset.appointment ?? "",
      date: row.dataset.dateKey ?? "",
      name: row.querySelector("[data-booking-name]")?.textContent ?? "",
      email: row.querySelector("[data-booking-email]")?.textContent ?? "",
    })),
  }));
  if (filters && search && bookingStatus && from && to) {
    const results = document.querySelector<HTMLElement>("[data-results]");
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]");
    const applyFilters = () => {
      const filter = { search: search.value, status: bookingStatus.value, from: from.value, to: to.value };
      const invalid = Boolean(filter.from && filter.to && filter.to < filter.from);
      to.setAttribute("aria-invalid", String(invalid));
      let count = 0;
      for (const { group, rows } of groups) {
        for (const row of rows) row.row.hidden = invalid || !matchesAppointment(row, filter);
        group.hidden = rows.every(({ row }) => row.hidden);
        count += rows.filter(({ row }) => !row.hidden).length;
      }
      if (results) results.textContent = invalid ? t("Bitiş tarihi başlangıçtan önce olamaz.") : `${count} ${t("randevu")}`;
      if (empty) empty.hidden = invalid || count !== 0 || groups.length === 0;
    };
    if (window.location.hash === "#pending") bookingStatus.value = "pending";
    filters.hidden = false;
    filters.addEventListener("input", applyFilters);
    filters.addEventListener("change", applyFilters);
    filters.querySelector("[data-clear]")?.addEventListener("click", () => {
      search.value = bookingStatus.value = from.value = to.value = "";
      if (window.location.hash === "#pending") history.replaceState(null, "", window.location.pathname);
      applyFilters();
      search.focus();
    });
    applyFilters();
  }

  const live = document.querySelector<HTMLElement>("[data-admin-live]");
  const status = document.querySelector<HTMLElement>("[data-refresh-status]");
  const refreshLink = document.querySelector<HTMLAnchorElement>("[data-refresh-link]");
  document.querySelector<HTMLElement>("[data-operation-feedback]")?.focus();

  document.querySelectorAll<HTMLButtonElement>("[data-dismiss-cancel]").forEach((button) => {
    button.addEventListener("click", () => {
      const details = button.closest("details");
      if (!details) return;
      details.open = false;
      details.querySelector("summary")?.focus();
    });
  });

  let submitting = false;
  document.querySelectorAll<HTMLFormElement>('.studio-body form[method="post"]').forEach((form) => {
    form.addEventListener("submit", (event) => {
      if (submitting) {
        event.preventDefault();
        return;
      }
      submitting = true;
      form.setAttribute("aria-busy", "true");
      (event as SubmitEvent).submitter?.setAttribute("aria-disabled", "true");
      const progress = document.createElement("span");
      progress.setAttribute("role", "status");
      progress.className = "studio-progress";
      progress.textContent = t("İşlem sürüyor…");
      form.after(progress);
    });
  });

  window.addEventListener("pageshow", (event) => {
    if (event.persisted && submitting) window.location.reload();
  });

  if (live && status && refreshLink) {
    const calendarStatus = document.querySelector<HTMLElement>("[data-calendar-status]");
    const systemCalendar = document.querySelector<HTMLElement>("[data-system-calendar]");
    const systemChecked = document.querySelector<HTMLElement>("[data-system-checked]");
    let lastSuccessful = live.dataset.signature ? status.textContent?.trim() ?? "" : "";
    let timer: number | undefined;
    let lastActivity = Date.now();
    const formatter = new Intl.DateTimeFormat(lang, {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: live.dataset.timeZone,
    });
    const canCheck = () => !submitting && document.visibilityState === "visible" &&
      !document.querySelector("[data-booking-editor][open]") &&
      !document.activeElement?.closest("form, [data-appointment-filters]") && Date.now() - lastActivity >= 5_000;

    for (const name of ["pointerdown", "keydown", "input", "change"]) {
      document.addEventListener(name, () => { lastActivity = Date.now(); }, { passive: true });
    }

    function showRefreshError(message: string) {
      status!.textContent = lastSuccessful ? message + " " + lastSuccessful : message;
    }
    function showCalendarState(label: string, available: boolean) {
      if (systemCalendar) systemCalendar.textContent = label;
      if (!calendarStatus) return;
      calendarStatus.textContent = label;
      calendarStatus.classList.toggle("studio-status--good", available);
      calendarStatus.classList.toggle("studio-status--attention", !available);
    }

    const refresh = createAdminRefresh({
      canCheck,
      async check(manual) {
        if (manual) status.textContent = t("Takvim yenileniyor…");
        try {
          const url = manual ? "/api/admin/bookings?refresh=1" : "/api/admin/bookings";
          const response = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(15_000) });
          if (response.status === 401) {
            window.location.assign("/admin?error=auth");
            return true;
          }
          const data = await response.json();
          if (!response.ok) {
            showCalendarState(data.error === "unconfigured" ? t("Yapılandırılmamış") : t("Takvim okunamadı"), false);
            showRefreshError(data.error === "unconfigured"
              ? t("Google Takvim bağlantısı yapılandırılmamış.") : t("Takvim yenilenemedi."));
            return false;
          }
          if (typeof data.signature !== "string" || typeof data.checkedAt !== "number") {
            throw new Error("Invalid refresh response");
          }
          lastSuccessful = t("Son başarılı güncelleme") + " " + formatter.format(data.checkedAt);
          status.textContent = lastSuccessful;
          showCalendarState(t("Takvim erişilebilir"), true);
          if (systemChecked) systemChecked.textContent = formatter.format(data.checkedAt);
          if (!submitting && data.signature !== live.dataset.signature && (manual || canCheck())) {
            try {
              sessionStorage.setItem("pekmen-admin-scroll", String(window.scrollY));
            } catch {
              // Reload still works without storage.
            }
            window.location.assign(window.location.pathname + window.location.hash);
          }
          return true;
        } catch {
          showCalendarState(t("Takvim durumu doğrulanamadı"), false);
          showRefreshError(t("Takvim yenilenemedi."));
          return false;
        }
      },
      schedule(delay) {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => { void refresh(); }, delay);
      },
    });

    refreshLink.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (!submitting) void refresh(true);
    });
    timer = window.setTimeout(() => { void refresh(); }, 45_000);

    if (window.location.search) history.replaceState(null, "", window.location.pathname + window.location.hash);
    try {
      const saved = sessionStorage.getItem("pekmen-admin-scroll");
      if (saved) {
        sessionStorage.removeItem("pekmen-admin-scroll");
        requestAnimationFrame(() => window.scrollTo(0, Number(saved) || 0));
      }
    } catch {
      // Storage may be disabled.
    }
  }
</script>
