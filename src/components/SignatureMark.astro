---
/**
 * The hero's personal mark: a handwritten signature.
 * Decorative — the name is already announced by the header brand.
 */
---

<div class="signature" aria-hidden="true">
  <span class="signature__name">Mert Pekmen</span>

  <svg class="signature__stroke" viewBox="0 0 240 18" fill="none" preserveAspectRatio="none">
    <path
      d="M3 12.5c22-6.4 51-9.2 78-7.1 18 1.4 33 4.6 50 3.4 20-1.4 34-6.4 52-7.2 14-.6 26 1.2 40 4.2"
      stroke="currentColor"
      stroke-width="1.1"
      stroke-linecap="round"
    />
  </svg>
</div>
