---
import AdminWorkspace from "../../components/admin/AdminWorkspace.astro";
import { ADMIN_COOKIE, verifySessionToken } from "../../server/admin";

import { studioSections, type StudioSection } from "../../server/studio";

export const prerender = false;
const requested = Astro.params.section;
if (!requested || requested === "overview" || (requested !== "system" && !Object.hasOwn(studioSections, requested))) {
  return new Response("Not found", { status: 404 });
}
if (!verifySessionToken(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect("/studio", 303);
}
const section = (requested === "system" ? "settings" : requested) as StudioSection;
---
<AdminWorkspace {section} />
