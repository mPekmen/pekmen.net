# Resend — contact form email (https://resend.com)
# Create an API key and verify pekmen.net under Domains.
RESEND_API_KEY=
CONTACT_TO=contact@pekmen.net
CONTACT_FROM=Pekmen <contact@pekmen.net>

# Google Calendar — OAuth client for appointment booking
# See docs/technical.md and scripts/google-oauth.mjs for the local OAuth flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Admin panel at /admin (bookings list + cancel)
ADMIN_PASSWORD=
# Independent 32-byte random key encoded as 64 hex characters.
ADMIN_SESSION_SECRET=
# Optional exact origin for staging. Production defaults to https://pekmen.net.
# ADMIN_ORIGIN=https://staging.example.com

# Booking rules (optional; these are the defaults)
BOOKING_TIMEZONE=Europe/Istanbul
BOOKING_DURATION_MINUTES=30
BOOKING_WORK_START=10
BOOKING_WORK_END=18
BOOKING_STEP_MINUTES=30
BOOKING_BUFFER_MINUTES=10
BOOKING_LEAD_HOURS=24
BOOKING_HORIZON_DAYS=60
BOOKING_WORK_DAYS=1,2,3,4,5
